<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings as a floating card on the right: margins from the inset, rounded corners, a hairline edge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0dp"
    android:insetTop="28dp"
    android:insetRight="28dp"
    android:insetBottom="28dp">
    <shape android:shape="rectangle">
        <solid android:color="#F2111820" />
        <corners android:radius="28dp" />
        <stroke android:width="1dp" android:color="#33FFFFFF" />
    </shape>
</inset>
