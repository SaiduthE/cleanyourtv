    <!-- Hold-OK tips: one or two short lines each, shown in a tip card under the row. -->
    <string name="ls_help_columns" translatable="false">How many app tiles fit across. Fewer means bigger tiles.</string>
    <string name="ls_help_rows_below" translatable="false">How many rows of apps stay visible under the dock.</string>
    <string name="ls_help_dock_opacity" translatable="false">How much the dock band hides the wallpaper. Lower shows more picture; 0% leaves the app tiles on their own.</string>
    <string name="ls_slider_hint" translatable="false">Left / Right to adjust, OK to set, Back to cancel</string>
    <string name="ls_help_open_on_start" translatable="false">An app that opens instead of Home when the TV starts. Back returns here.</string>
    <string name="ls_help_style" translatable="false">The look of Clean Look: wallpaper, dock, columns and colours.</string>
    <string name="ls_help_wallpaper" translatable="false">Pick one picture to keep, or let the theme change it.</string>
    <string name="ls_help_clock" translatable="false">System follows the TV\'s own 12 or 24 hour setting.</string>
    <string name="ls_help_icons" translatable="false">Rounded or the original icons, in the top bar, menus and widgets.</string>
    <string name="ls_help_animations" translatable="false">Off makes every move instant, for slow TVs.</string>
    <string name="ls_help_glass_frost" translatable="false">How much of a frosted copy of the wallpaper shows behind glass panels. 0 turns it off.</string>
    <string name="ls_help_glass_edge" translatable="false">A lit rim on glass panels, pills and the dock.</string>
    <string name="ls_help_glass_refraction" translatable="false">Glass bends what is behind it, like a lens, with a curved edge. Off keeps it flat.</string>
    <string name="ls_help_grain" translatable="false">Fine film grain that keeps gradients from banding. 0 turns it off.</string>
    <string name="ls_help_advanced" translatable="false">Lifted tile, icon zoom and smooth colours. May use more memory.</string>
    <string name="ls_help_advanced_off" translatable="false">Turn Animations on first. Advanced effects need them.</string>
    <string name="ls_help_remote_buttons" translatable="false">Map a remote button to an app or action: press, hold or double press.</string>
    <string name="ls_help_reorder" translatable="false">Pick up an app and move it. OK or Back puts it down.</string>
    <string name="ls_help_edit_dock" translatable="false">Choose which apps sit in the dock band.</string>
    <string name="ls_help_default_home" translatable="false">Switch between Clean Look and the TV\'s original Home.</string>
    <string name="ls_help_tv_settings" translatable="false">Opens the TV\'s own settings.</string>
    <string name="ls_help_reset" translatable="false">Clears your choices here and goes back to the theme\'s own settings.</string>
    <string name="ls_help_reset_none" translatable="false">Nothing was changed here, so the theme\'s own settings are in use.</string>
